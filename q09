/*
 *  Q9. Write a program to access the 3rd, last and first
 *      elements of an array using their index.
 */

#include <stdio.h>

int main()
{
    // Array declaration and initialization
    int arr[5] = {2, 4, 8, 12, 16};

    // Index 2 = 3rd element
    printf("%d ", arr[2]);

    // Index 4 = last element
    printf("%d ", arr[4]);

    // Index 0 = first element
    printf("%d ", arr[0]);

    return 0;
}
/*
*  Output:
 *      8 16 2
    */
